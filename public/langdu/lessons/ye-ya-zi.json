        {
          "text": "野鸭子，岸边走，",
          "image": "images/ye-ya-zi/01.jpg"
        },
        {
          "text": "拍拍翅膀抖抖毛。",
          "image": "images/ye-ya-zi/02.jpg"
        },
        {
          "text": "走入湖中找食物，",
          "image": "images/ye-ya-zi/03.jpg"
        },
        {
          "text": "顺着水流往下游。",
          "image": "images/ye-ya-zi/04.jpg"
        }
      ]
    }
  ],
