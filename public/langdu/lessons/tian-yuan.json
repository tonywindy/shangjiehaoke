  "paragraphs": [
    {
      "sentences": [
        {
          "text": "河水流，鱼儿游，河底贝壳不会游。",
          "image": "images/tian-yuan/01.jpg"
        },
        {
          "text": "河岸边，禾苗笑，竹林里面虫子叫。",
          "image": "images/tian-yuan/02.jpg"
        },
        {
          "text": "山青青，水绿绿，田园风光真美丽。",
          "image": "images/tian-yuan/03.jpg"
        }
      ]
    }
  ],
