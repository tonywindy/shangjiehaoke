  "theme": "#F06292",
  "paragraphs": [
    {
      "sentences": [
        {
          "text": "小朋友，抬起手，轻轻摸摸小脸蛋，",
          "image": "images/lian/01.jpg"
        },
        {
          "text": "脸蛋两侧有耳朵，额头下面有眉毛，",
          "image": "images/lian/02.jpg"
        },
        {
          "text": "眉毛下面是眼睛，眼睛下面是鼻子，",
          "image": "images/lian/03.jpg"
        },
        {
          "text": "鼻子下面是嘴巴，口中长着小舌头。",
          "image": "images/lian/04.jpg"
        }
      ]
    }
  ],
