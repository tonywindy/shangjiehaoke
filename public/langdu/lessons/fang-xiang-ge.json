        {
          "text": "小朋友，看地图，方向口诀记心内，",
          "image": "images/fang-xiang-ge/01.jpg"
        },
        {
          "text": "上是北，下是南，左是西，右是东。",
          "image": "images/fang-xiang-ge/02.jpg"
        },
        {
          "text": "小朋友，外出时，早晨面向太阳走，前是东，后是西，左是北，右是南。",
          "image": "images/fang-xiang-ge/03.jpg"
        }
      ]
    }
