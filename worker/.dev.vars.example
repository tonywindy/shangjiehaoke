# 仅供本地 wrangler dev 使用。复制为 .dev.vars 后填入真实值；不要提交 .dev.vars。
WORKSPACE_ADMIN_PASSWORD_HASH=pbkdf2_sha256$100000$replace-salt$replace-hash
WORKSPACE_SESSION_SECRET=replace-with-at-least-32-random-bytes
WORKSPACE_LICENSE_PEPPER=replace-with-another-random-value
WORKSPACE_PASSWORD_PEPPER=replace-with-a-third-independent-random-value
