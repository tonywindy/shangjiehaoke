{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shangjiehaoke-ai-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-18",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "api.shangjiehaoke.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"TEACHER_USERNAME": "yuanlaoshi",
		"TEACHER_DISPLAY_NAME": "袁老师"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shangjiehaoke-ai-db",
			"database_id": "d02d1339-b537-4b35-b511-f32f8571d254"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "shangjiehaoke-ai-evidence",
			"binding": "EVIDENCE"
		}
	]
}
